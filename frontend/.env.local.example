# Copy to .env.local. Only needed if the backend isn't on localhost:8000.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Public website address (link previews, canonical URLs, sitemap).
NEXT_PUBLIC_SITE_URL=https://www.aryavedamehndi.com

# Marketing - leave blank to turn off. Only loaded after a visitor accepts
# the cookie banner. GA4 "Measurement ID" (G-XXXXXXX; link it to Google Ads
# for conversion tracking) and the Meta Pixel ID from Events Manager.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Seller & grievance details shown on Contact / Refund / Shipping / Terms.
# Required before launch (E-Commerce Rules 2020, IT Rules 2021, Razorpay KYC).
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
# State of GST registration, spelt as in the checkout list (e.g. Delhi).
NEXT_PUBLIC_BUSINESS_STATE=
NEXT_PUBLIC_BUSINESS_GSTIN=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_HOURS=Monday to Saturday, 10 am to 7 pm IST
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=
NEXT_PUBLIC_GRIEVANCE_OFFICER_PHONE=
