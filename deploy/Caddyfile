# HTTPS for the website and the API; certificates are issued and renewed
# automatically. Domains come from deploy/.env.
{
	email {$ACME_EMAIL}
}

{$APEX_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy web:3000
}

{$API_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	request_body {
		max_size 25MB
	}
	reverse_proxy api:8000
}
