# Copy this file to .env and fill in real values.

# "development" | "production". In production the app refuses to start if
# JWT_SECRET is still the placeholder, OTP_DEV_MODE is still true, or
# CORS_ORIGINS allows "*" - see app/main.py::_check_production_safety.
APP_ENV=development

# postgresql+psycopg://<user>:<password>@localhost:5432/aryamehndi
DATABASE_URL=postgresql+psycopg://aryamehndi_app:changeme@localhost:5432/aryamehndi

JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Dev mode: OTP is returned in the API response and printed to the server
# console instead of being sent by SMS. Set to false once MSG91 keys below
# are filled in, to send real SMS.
OTP_DEV_MODE=true
MSG91_AUTH_KEY=
MSG91_SENDER_ID=ARYAMH
MSG91_OTP_TEMPLATE_ID=

# Razorpay test-mode keys (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks: URL <PUBLIC_API_URL>/payments/razorpay/webhook,
# events payment.captured and order.paid; paste the secret you chose here.
RAZORPAY_WEBHOOK_SECRET=

# Google Maps Distance Matrix API key, used for artist ETA calculation.
GOOGLE_MAPS_API_KEY=

# Object storage for portfolio photos, design references and uploads.
# Leave blank to fall back to local disk storage under ./media (dev only).
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# Public addresses used in links that leave the site (e.g. the ad product
# feed at /shop/feed.csv): the website, and this API (serves /media files).
PUBLIC_SITE_URL=https://www.aryavedamehndi.com
PUBLIC_API_URL=http://localhost:8000

# Minimum similarity score (0-100) between the chosen reference design and
# the artist's uploaded completed-work photo that auto-clears payment.
DESIGN_MATCH_THRESHOLD=90

# Platform fee taken on top of the negotiated package price.
PLATFORM_FEE_MODE=percent
PLATFORM_FEE_PERCENT=10
PLATFORM_FEE_FLAT=0

CORS_ORIGINS=http://localhost:3000

# Max size (MB) accepted for any image upload (KYC docs, avatars, designs,
# portfolio, package/CMS photos). Uploads are also verified to be real,
# decodable images - not just checked by file extension.
MAX_UPLOAD_SIZE_MB=8

# Masked calling between customer and artist (Exotel). Leave blank to turn
# off - in production the call button is then hidden.
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_VIRTUAL_NUMBER=
