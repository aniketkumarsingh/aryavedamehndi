# Copy to deploy/.env (never commit it) and fill in. Used by
# docker-compose.yml for every service.

# ---- domains & certificates
SITE_DOMAIN=www.aryavedamehndi.com
APEX_DOMAIN=aryavedamehndi.com
API_DOMAIN=api.aryavedamehndi.com
ACME_EMAIL=you@example.com

# ---- database (the compose file builds DATABASE_URL from these)
POSTGRES_USER=aryamehndi_app
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=aryamehndi

# ---- API & worker (see backend/.env.example for what each does)
APP_ENV=production
JWT_SECRET=change-me-to-64-random-characters
OTP_DEV_MODE=false
CORS_ORIGINS=https://www.aryavedamehndi.com
PUBLIC_SITE_URL=https://www.aryavedamehndi.com
PUBLIC_API_URL=https://api.aryavedamehndi.com
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
# Backups go to this (private) bucket under backups/; defaults to S3_BUCKET.
BACKUP_S3_BUCKET=
BACKUP_RETENTION_DAYS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SENTRY_DSN=
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_VIRTUAL_NUMBER=

# ---- seller details (invoices, policy pages and contact page)
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_STATE=
BUSINESS_GSTIN=
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=

# ---- website build-time settings
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_SENTRY_DSN=
